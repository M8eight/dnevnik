livedebugging {
  enabled = true
}

local.file_match "log_files" {
  path_targets = [
    {"__path__" = "/app/logs/*/*.log"},
  ]
}

loki.source.file "app_logs" {
  targets    = local.file_match.log_files.targets
  forward_to = [loki.process.parse.receiver]
}

loki.process "parse" {
stage.json {
    expressions = {
      level     = "level",
      app       = "app",
      traceId   = "traceId",
      spanId    = "spanId",
      userId    = "userId",
      timestamp = "\"@timestamp\"",
    }
}

  stage.labels {
    values = {
      level = "",
      app   = "",
    }
  }

  stage.structured_metadata {
    values = {
      traceId = "",
      spanId  = "",
      userId  = "",
    }
  }

  stage.timestamp {
    source = "timestamp"
    format = "RFC3339"
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}